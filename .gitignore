.venv/
__pycache__/
.DS_Store

# Layer 1: raw downloads (~15 GB). Never in git; re-create with ./download_data.sh.
# (EPC address fields in data/raw/epc are not open data and must not be published.)
data/raw/

# Layer 3: the site's data files are generated from data/extracts by build_data.py
# (locally, or by the GitHub Actions workflow when publishing).
site/*.js
